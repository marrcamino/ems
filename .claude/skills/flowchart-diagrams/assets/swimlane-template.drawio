<mxfile host="app.diagrams.net" type="device">
  <diagram id="flow" name="1 - The flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="What happens when &amp;lt;the trigger&amp;gt;" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="10" width="1200" height="40" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;How to read this&lt;/b&gt;&amp;nbsp;&amp;nbsp; Stadium = start or end&amp;nbsp; &amp;middot;&amp;nbsp; Rectangle = a step the system performs&amp;nbsp; &amp;middot;&amp;nbsp; Diamond = a question, every exit named&amp;nbsp; &amp;middot;&amp;nbsp; Parallelogram = something a person sees or answers&amp;nbsp; &amp;middot;&amp;nbsp; Cylinder = one table (the arrow says INSERT / UPDATE / DELETE)&amp;nbsp; &amp;middot;&amp;nbsp; Yellow note = why, not what.&amp;nbsp; The columns say &lt;b&gt;who&lt;/b&gt; does the work." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="0" y="60" width="1600" height="60" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="Person / browser" style="swimlane;html=1;horizontal=1;startSize=40;fillColor=none;strokeColor=#999999;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="0" y="140" width="520" height="1520" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Start: the thing that kicks it off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneA">
          <mxGeometry x="100" y="70" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dec1" value="A yes / no question?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneA">
          <mxGeometry x="60" y="180" width="400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="io1" value="What the person is shown, and is asked to answer" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;size=20;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneA">
          <mxGeometry x="50" y="570" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dec2" value="Which answer was given?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneA">
          <mxGeometry x="50" y="730" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="endCancel" value="Done&lt;br&gt;nothing written" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneA">
          <mxGeometry x="10" y="970" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="endDone" value="Done&lt;br&gt;what the person now sees" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneA">
          <mxGeometry x="120" y="1400" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="laneB" value="Server" style="swimlane;html=1;horizontal=1;startSize=40;fillColor=none;strokeColor=#999999;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="600" height="1520" as="geometry" />
        </mxCell>
        <mxCell id="pSimple" value="The short path: one step, nothing else changes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB">
          <mxGeometry x="80" y="190" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="endSimple" value="Done" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneB">
          <mxGeometry x="230" y="320" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="pRead" value="A read-only step. Nothing is written yet." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB">
          <mxGeometry x="80" y="410" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pBranch1" value="What the first answer does" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB">
          <mxGeometry x="80" y="930" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pBranch2" value="What the second answer does" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB">
          <mxGeometry x="80" y="1110" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pCommit" value="Commit. Both writes land together." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="laneB">
          <mxGeometry x="80" y="1290" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="laneC" value="Database" style="swimlane;html=1;horizontal=1;startSize=40;fillColor=none;strokeColor=#999999;fontSize=14;fontStyle=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="480" height="1520" as="geometry" />
        </mxCell>
        <mxCell id="dbSimple" value="table_one" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneC">
          <mxGeometry x="60" y="195" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dbRead" value="table_two" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneC">
          <mxGeometry x="60" y="415" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dbW1" value="table_two&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;the rows holding the old value&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneC">
          <mxGeometry x="60" y="935" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dbW2" value="table_two" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="laneC">
          <mxGeometry x="60" y="1115" width="360" height="80" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;Why this step is separate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Put the reasoning here, not inside the box. The box says what happens; the note says why it has to happen that way." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1640" y="540" width="380" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;Why one commit&lt;/b&gt;&lt;br&gt;&lt;br&gt;All of it happens or none of it does, so the two tables can never disagree." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1640" y="1400" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="x1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="dec1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x2" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="dec1" target="pSimple"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x3" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pSimple" target="dbSimple"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pSimple" target="endSimple"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x5" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="dec1" target="pRead"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x6" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pRead" target="dbRead"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pRead" target="io1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="io1" target="dec2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x9" value="Answer A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="dec2" target="pBranch1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x10" value="Answer B" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="dec2" target="pBranch2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x11" value="Cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontStyle=1;" edge="1" parent="1" source="dec2" target="endCancel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x12" value="UPDATE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pBranch1" target="dbW1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x13" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pBranch2" target="dbW2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pBranch1" target="pCommit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pBranch2" target="pCommit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="x16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="pCommit" target="endDone"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" edge="1" parent="1" source="pRead" target="note1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="n2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=none;" edge="1" parent="1" source="pCommit" target="note2"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="words" name="0 - Words used here">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="gt" value="The words used in the flow, and what each one means" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gw1" value="&lt;b&gt;Term one&lt;/b&gt;&lt;br&gt;&lt;br&gt;Plain-language definition. Keep the glossary on its own page so it does not compete with the flow for attention." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gw2" value="&lt;b&gt;Term two&lt;/b&gt;&lt;br&gt;&lt;br&gt;One term per box, same size, laid out in a grid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="90" width="440" height="180" as="geometry" />
        </mxCell>
        <mxCell id="gw3" value="&lt;b&gt;Term three&lt;/b&gt;&lt;br&gt;&lt;br&gt;Define anything the flow's node labels assume the reader already knows." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="90" width="440" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>