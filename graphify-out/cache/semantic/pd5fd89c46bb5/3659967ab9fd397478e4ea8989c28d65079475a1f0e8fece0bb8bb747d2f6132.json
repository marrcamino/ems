{"nodes": [{"id": "_claude_skills_commit_message_skill_commit_message_format", "label": "Commit Message Format", "file_type": "rationale", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "# Commit message format", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The repo enforces one house shape for commit messages so history stays scannable: a conventional prefix and short lowercase title, a blank line, then a wrapped bullet list. Prose paragraphs are rejected because they bury several logical changes in one block."}, {"id": "_claude_skills_commit_message_skill_conventional_prefix_title", "label": "Conventional Prefix Title", "file_type": "rationale", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Title", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The title takes a conventional prefix (feat, fix, refactor, chore, docs, test), a lowercase first letter, no trailing period, and stays under about 72 characters. Previously untracked files are feat rather than refactor, because nothing existed yet to refactor."}, {"id": "_claude_skills_commit_message_skill_bullet_body", "label": "Bullet Body", "file_type": "rationale", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The body is bullets only, wrapped at 72 characters with two-space continuation indents, one bullet per logical change, three to six bullets in total. Identifiers are written out literally. A commit that needs more than six bullets is probably doing too much and should be split."}, {"id": "_claude_skills_commit_message_skill_staging_scope", "label": "Staging Scope", "file_type": "rationale", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## What to stage", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Which files get staged is settled before the message is written, because the wrong scope forces an amend or a reset afterwards. Three phrases select the scope and the widest one is also the default; the scope is never widened on the agent's own initiative."}, {"id": "_claude_skills_commit_message_skill_commit_staged_files", "label": "Commit Staged Files Scope", "file_type": "concept", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit staged files", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commits exactly the existing index, read with git diff --cached --name-only, and stages nothing new. When the index is empty the run stops and says so rather than guessing at something to add."}, {"id": "_claude_skills_commit_message_skill_commit_primary_changes", "label": "Commit Primary Changes Scope", "file_type": "concept", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit primary changes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stages only the files created or modified while completing the current session's task, named one by one instead of git add -A. When the session holds no completed task the files may have changed for reasons never observed, so the correct move is to ask which files are primary rather than guess."}, {"id": "_claude_skills_commit_message_skill_commit_this", "label": "Commit This Scope", "file_type": "concept", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit this and the default", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default when no scope is named: git add -A sweeps modified, deleted, and untracked files. Whatever got swept in that is not the main work is called out in the trailing bullet, and a file that should not be in the repo at all is named and left out rather than committed quietly."}, {"id": "_claude_skills_commit_message_skill_default_ordering", "label": "Default Body Ordering", "file_type": "rationale", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### Default ordering", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main changes come first, most important first, then anything swept into the same commit that is not part of that work. Trailing bullets stay short; an unrelated change big enough to need its own explanation belongs in its own commit instead."}, {"id": "_claude_skills_commit_message_skill_no_trailers", "label": "No Commit Trailers", "file_type": "concept", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Body", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No Co-Authored-By trailer and no generated-with footer are permitted anywhere in the message."}, {"id": "_claude_skills_commit_message_skill_final_check", "label": "Pre-Commit Format Check", "file_type": "concept", "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Check before finishing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A closing checklist re-verifies the staging scope, the prefix and lowercase title, the blank line after it, main-before-unrelated ordering, a bullet or two-space wrap on every body line, the 72-character limit, and the absence of trailers."}], "edges": [{"source": "_claude_skills_commit_message_skill_commit_message_format", "target": "_claude_skills_commit_message_skill_conventional_prefix_title", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Title", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_commit_message_format", "target": "_claude_skills_commit_message_skill_bullet_body", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Body", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_commit_message_format", "target": "_claude_skills_commit_message_skill_staging_scope", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## What to stage", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_staging_scope", "target": "_claude_skills_commit_message_skill_commit_staged_files", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit staged files", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_staging_scope", "target": "_claude_skills_commit_message_skill_commit_primary_changes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit primary changes", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_staging_scope", "target": "_claude_skills_commit_message_skill_commit_this", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit this and the default", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_bullet_body", "target": "_claude_skills_commit_message_skill_default_ordering", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### Default ordering", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_bullet_body", "target": "_claude_skills_commit_message_skill_no_trailers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Body", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_final_check", "target": "_claude_skills_commit_message_skill_commit_message_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Check before finishing", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_commit_this", "target": "_claude_skills_commit_message_skill_default_ordering", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "### commit this and the default", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_commit_primary_changes", "target": "_claude_skills_commit_message_skill_conventional_prefix_title", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_bullet_body", "target": "src_lib_rbac_access", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Good", "weight": 1.0}, {"source": "_claude_skills_commit_message_skill_bullet_body", "target": "src_lib_server_permissions_permission_defs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md", "source_location": "## Good", "weight": 1.0}], "hyperedges": [{"id": "commit_message_staging_scopes", "label": "Commit Staging Scope Selection", "nodes": ["_claude_skills_commit_message_skill_staging_scope", "_claude_skills_commit_message_skill_commit_staged_files", "_claude_skills_commit_message_skill_commit_primary_changes", "_claude_skills_commit_message_skill_commit_this"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/commit-message/SKILL.md"}]}