{"nodes": [{"id": "_claude_skills_rbac_design_skill_rbac_locked_decisions", "label": "RBAC Locked Decisions", "file_type": "document", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written as locked decisions so permission work does not re-litigate settled design each time it is touched."}, {"id": "_claude_skills_rbac_design_skill_user_role_permission_model", "label": "User to Role to Permission Model", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One role per user with no per-user overrides; a person needing a different set gets a duplicated role instead."}, {"id": "_claude_skills_rbac_design_skill_permission_key_checks", "label": "Check Permission Keys, Never Role Names", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Role names are runtime data an admin can rename, while keys are defined in source and cannot change underneath the code."}, {"id": "_claude_skills_rbac_design_skill_admin_role_kind", "label": "Admin Role Kind", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Admin roles hold only admin keys because a staff permission is unusable to a user whose navigation is confined to the admin routes."}, {"id": "_claude_skills_rbac_design_skill_staff_role_kind", "label": "Staff Role Kind", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_rbac_design_skill_mirrored_admin_staff_routes", "label": "Mirrored Admin and Staff Data Routes", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as separate routes rather than one route branching on permissions, because the admin table has features the staff table does not and merging them would tangle two interfaces."}, {"id": "_claude_skills_rbac_design_skill_permission_key_shape", "label": "Permission Key Shape", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PERMISSION_DEFS is the single source, so a new module or action is added in exactly one place."}, {"id": "_claude_skills_rbac_design_skill_keys_built_forward", "label": "Keys Built Forward, Never Split Apart", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The underscore is both the separator and a legal character inside a submodule name, so a finished key cannot be parsed back into its parts unambiguously."}, {"id": "_claude_skills_rbac_design_skill_one_submodule_level", "label": "One Level of Submodules", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deeper nesting would make the action-first flattening ambiguous."}, {"id": "_claude_skills_rbac_design_skill_mandatory_view_action", "label": "Mandatory View Action Per Module", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each route load function checks the module view key, so a module without one is unreachable by anybody."}, {"id": "_claude_skills_rbac_design_skill_implied_permissions", "label": "Implied Permissions", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unrecognised keys pass through untouched rather than being dropped, so a leftover database row never silently removes access it was already granting."}, {"id": "_claude_skills_rbac_design_skill_expand_permissions_chain", "label": "Expand Permissions Walks the Whole Chain", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PERMISSION_IMPLIES stores single steps only, and expansion is idempotent, so it is safe to apply anywhere."}, {"id": "_claude_skills_rbac_design_skill_role_editor_auto_tick", "label": "Role Editor Auto-Tick", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Managing a page you cannot open is meaningless, so any non-view action ticks its module view, and unticking view clears the module."}, {"id": "_claude_skills_rbac_design_skill_hidden_roles_keys", "label": "Roles Page Keys Hidden From the Editor", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absent rather than greyed out, so no admin can grant the restricted key through the interface at all."}, {"id": "_claude_skills_rbac_design_skill_server_side_expansion", "label": "Server-Side Expansion Before Writing", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The browser can be bypassed, so expanding on the server means the database can never reach a state the interface would not have produced."}, {"id": "_claude_skills_rbac_design_skill_super_admin_role", "label": "Super-Admin Role", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identified by holding the roles-management key rather than by name, since names are editable runtime data."}, {"id": "_claude_skills_rbac_design_skill_frozen_super_admin", "label": "Frozen Super-Admin Role", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the description is editable; name, status, and the permission set are locked, and deletion, deactivation, and duplication are blocked."}, {"id": "_claude_skills_rbac_design_skill_roles_page_restriction", "label": "Roles Editor Is Super-Admin Only", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "View is withheld alongside manage because a Roles page nobody can edit has no reason to exist, so the read-only rendering is never built."}, {"id": "_claude_skills_rbac_design_skill_no_is_protected_column", "label": "Protection From a Live Condition, Not a Column", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is no protection flag column; protection is derived by asking whether the role currently holds the roles-management key."}, {"id": "_claude_skills_rbac_design_skill_one_holder_only", "label": "Exactly One Holder of the Restricted Key", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforced as a safety net against a bypassed request, since the interface already makes the key unreachable."}, {"id": "_claude_skills_rbac_design_skill_never_zero_holders", "label": "Never Zero Active Super-Admins", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any action dropping the count to zero is blocked; going from two down to one warns but is allowed."}, {"id": "_claude_skills_rbac_design_skill_no_self_role_change", "label": "No User Changes Their Own Role", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents both self-promotion and self-lockout, where an admin strips their own access to the only page that could undo it."}, {"id": "_claude_skills_rbac_design_skill_only_super_admin_assigns", "label": "Only a Super-Admin Assigns Super-Admin", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Together with the self-change rule this closes the grant path: a user manager can neither promote themselves nor a colleague, and unassignment is restricted the same way."}, {"id": "_claude_skills_rbac_design_skill_role_templates", "label": "Role Templates", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-checked defaults only; never saved as records, so a created role keeps no connection to the template it came from."}, {"id": "_claude_skills_rbac_design_skill_super_admin_template", "label": "Super Admin Template", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only template including the Roles page keys, and what the bootstrap script reads on a fresh server."}, {"id": "_claude_skills_rbac_design_skill_admin_template", "label": "Admin Template", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Derived by filtering rather than listed by hand, so a new admin page is picked up automatically while the Roles page stays excluded."}, {"id": "_claude_skills_rbac_design_skill_bootstrap_create_admin", "label": "Bootstrap via create-admin", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finds the super-admin role by permission rather than by name, creating it from the template only when none exists."}, {"id": "_claude_skills_rbac_design_skill_permission_sync", "label": "Permission Sync", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permission rows are data, not schema, so the migration generator produces nothing for a new key and this script is what puts it into the database."}, {"id": "_claude_skills_rbac_design_skill_orphan_reporting", "label": "Orphan Keys Reported, Never Deleted", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The join table is declared without a delete cascade, so MySQL restricts the delete; clearing an orphan means removing live role grants first, which is not a decision a script should make unattended."}, {"id": "_claude_skills_rbac_design_skill_super_admin_backfill", "label": "Super-Admin Backfill", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Required because the frozen role has no interface path to gain a new module."}, {"id": "_claude_skills_rbac_design_skill_open_staff_actions", "label": "Open: Staff Module Actions Beyond View", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blocked on deciding whether encoder-submitted data needs approval before it counts toward reports."}, {"id": "_claude_skills_rbac_design_skill_open_orphan_cleanup", "label": "Open: Orphan Cleanup", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Orphans are removed by hand today; whether the sync script should offer deletion is undecided and not urgent."}, {"id": "_claude_skills_rbac_design_skill_open_role_contents", "label": "Open: Surfacing Role Contents Outside the Roles Page", "file_type": "rationale", "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A user manager assigns roles by name alone; a popover listing the selected role permissions is the likely fix."}], "edges": [{"source": "_claude_skills_rbac_design_skill_rbac_locked_decisions", "target": "_claude_skills_rbac_design_skill_user_role_permission_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_rbac_locked_decisions", "target": "_claude_skills_rbac_design_skill_permission_key_shape", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_rbac_locked_decisions", "target": "_claude_skills_rbac_design_skill_implied_permissions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_rbac_locked_decisions", "target": "_claude_skills_rbac_design_skill_roles_page_restriction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_rbac_locked_decisions", "target": "_claude_skills_rbac_design_skill_role_templates", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_user_role_permission_model", "target": "_claude_skills_rbac_design_skill_permission_key_checks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_user_role_permission_model", "target": "_claude_skills_rbac_design_skill_admin_role_kind", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_user_role_permission_model", "target": "_claude_skills_rbac_design_skill_staff_role_kind", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_admin_role_kind", "target": "_claude_skills_rbac_design_skill_mirrored_admin_staff_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_staff_role_kind", "target": "_claude_skills_rbac_design_skill_mirrored_admin_staff_routes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_permission_key_shape", "target": "_claude_skills_rbac_design_skill_keys_built_forward", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_permission_key_shape", "target": "_claude_skills_rbac_design_skill_one_submodule_level", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_permission_key_shape", "target": "_claude_skills_rbac_design_skill_mandatory_view_action", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_implied_permissions", "target": "_claude_skills_rbac_design_skill_expand_permissions_chain", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_role_editor_auto_tick", "target": "_claude_skills_rbac_design_skill_implied_permissions", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_role_editor_auto_tick", "target": "_claude_skills_rbac_design_skill_server_side_expansion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_hidden_roles_keys", "target": "_claude_skills_rbac_design_skill_roles_page_restriction", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_roles_page_restriction", "target": "_claude_skills_rbac_design_skill_super_admin_role", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_super_admin_role", "target": "_claude_skills_rbac_design_skill_frozen_super_admin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/rbac-design/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_rbac_design_skill_super_admin_role", "target": "_claude_skills_rbac_design_skill_no_is_protected_column", "relation": "ref